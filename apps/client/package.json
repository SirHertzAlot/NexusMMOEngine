{
  "dependencies": {
    "@mmo-engine/art": "0.1.0",
    "@mmo-engine/compose": "0.1.0",
    "@mmo-engine/mirror": "0.1.0",
    "@mmo-engine/picg": "0.1.0",
    "@mmo-engine/protocol": "^0.1.0",
    "@mmo-engine/scene": "0.1.0",
    "@mmo-engine/schema": "0.1.0",
    "@pmndrs/detect-gpu": "^6.0.24",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@takram/three-atmosphere": "^0.19.1",
    "@takram/three-geospatial": "^0.9.1",
    "flatbuffers": "^25.9.23",
    "meshoptimizer": "^1.3.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.15",
    "three-nebula": "^13.3.0",
    "three.quarks": "^0.17.1"
  },
  "description": "three.js mirror client: React + shadcn + Tailwind shell, three.js canvas rendering authoritative ECS snapshots/deltas with interpolation (Phase 3)",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "leva": "^0.10.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  },
  "name": "@mmo-engine/client",
  "private": true,
  "scripts": {
    "build": "npm run build:deps && npm run build:lib && vite build",
    "build:deps": "npm run build --workspace=@mmo-engine/scene && npm run build --workspace=@mmo-engine/schema && npm run build --workspace=@mmo-engine/protocol && npm run build --workspace=@mmo-engine/art && npm run build --workspace=@mmo-engine/mirror && npm run build --workspace=@mmo-engine/picg && npm run build --workspace=@mmo-engine/compose",
    "build:lib": "tsc -p tsconfig.json",
    "predev": "npm run build:deps",
    "dev": "vite",
    "preview": "vite preview",
    "pretest": "npm run build:deps",
    "test": "npm run build:lib && node --test \"dist/test/**/*.test.js\"",
    "surfaces:fetch": "node scripts/fetch-surfaces.mjs"
  },
  "type": "module",
  "version": "0.1.0"
}
