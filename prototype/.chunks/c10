/* ============ STATE + GRAPH HELPERS ============ */
const N = {}; GRAPH.nodes.forEach(n=>N[n.id]=n);
const state = { selected:"object:town0001/stall", role:"all", depth:"object", expanded:new Set(["component:Transform"]), graph:false, showInfra:false, stock:12, widgetOpen:false, debug:false, playing:false, scene:"market", pan:{x:0,y:0}, zoom:1, justDragged:false };
const SCENES = { market:"Market Square", gate:"North Gate", fields:"Fields" };
const edgesFrom=(id,kind)=>GRAPH.edges.filter(e=>e.from===id&&(!kind||e.kind===kind));
const edgesTo=(id,kind)=>GRAPH.edges.filter(e=>e.to===id&&(!kind||e.kind===kind));
function archetypeOf(objId){ const e=edgesFrom(objId,"instantiates")[0]; return e?N[e.to]:null; }
function componentsOf(objId){ const a=archetypeOf(objId); return a?edgesFrom(a.id,"hasComponent").map(e=>N[e.to]):[]; }
function systemsFor(targetId){ // targetId: component or field id
  const out=[];
  for(const e of GRAPH.edges){ if(e.to===targetId&&(e.kind==="reads"||e.kind==="writes")) out.push({sys:N[e.from],kind:e.kind,confidence:e.confidence}); }
  return out;
}
function objectSystems(objId){
  const seen=new Map();
  for(const c of componentsOf(objId)){
    for(const s of systemsFor(c.id)) seen.set(s.sys.id,s.sys);
    for(const f of c.fields) for(const s of systemsFor("field:"+c.name+"."+f.name)) seen.set(s.sys.id,s.sys);
  }
  return [...seen.values()].sort((a,b)=>(a.tickIndex||99)-(b.tickIndex||99));
}
function prov(verb, what, why){
  document.getElementById("provVerb").textContent=verb;
  document.getElementById("provText").textContent=`who: Joey · what: ${what} · when: ${new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})} · where: Market Square · why: “${why}”`;
}

/* ============ RENDER: hierarchy ============ */
const ROLES=[["all","All"],["characters","Characters"],["vendors","Vendors"],["creatures","Creatures"],["props","Props"]];
function renderChips(){
  document.getElementById("roleChips").innerHTML = ROLES.map(([k,l])=>
    `<button class="badge ${state.role===k?'bg-primary text-primary-foreground border-transparent':'badge-outline hover:bg-accent'} transition-colors" data-role="${k}">${l}</button>`).join("");
  document.querySelectorAll("#roleChips [data-role]").forEach(ch=>ch.onclick=()=>{state.role=ch.dataset.role;renderChips();renderTree();});
}
function renderTree(){
  const objs=GRAPH.nodes.filter(n=>n.kind==="object");
  const sceneRow=(k,l)=>`<div class="tnode ${state.scene===k?'sel':''}" style="margin-left:10px" tabindex="0" role="treeitem" aria-selected="${state.scene===k}" data-scene="${k}">▸ <span>${l}</span></div>`;
  let h=`<div class="px-2 pb-0.5 pt-1 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">▾ Town 0001</div>`+sceneRow("market","Market Square");
  if(state.scene==="market") for(const o of objs){
    const dim = state.role!=="all" && o.role!==state.role;
    h+=`<div class="tnode ${o.id===state.selected?'sel':''} ${dim?'opacity-40':''}" style="margin-left:22px" tabindex="0" role="treeitem" aria-selected="${o.id===state.selected}" data-obj="${o.id}">▸ <span class="truncate">${o.name}</span> <span class="ml-auto text-[11px] text-muted-foreground">${o.spawnSource}</span></div>`;
  }
  h+=sceneRow("gate","North Gate")+sceneRow("fields","Fields");
  document.getElementById("tree").innerHTML=h;
  document.querySelectorAll("#tree [data-obj]").forEach(t=>t.onclick=()=>select(t.dataset.obj,false));
  document.querySelectorAll("#tree [data-scene]").forEach(t=>t.onclick=()=>loadScene(t.dataset.scene));
  document.querySelectorAll("#tree [data-obj], #tree [data-scene]").forEach(t=>t.onkeydown=e=>{ if(e.key==="Enter"||e.key===" "){ e.preventDefault(); t.click(); } });
}
