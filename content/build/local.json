{
  "version": 1,
  "name": "local",
  "description": "The server, the edge and the client built, baked and packaged for this machine.",
  "target": "local",
  "build": [
    "@mmo-engine/engine-core",
    "@mmo-engine/edge",
    "@mmo-engine/dungeon",
    "@mmo-engine/compose",
    "@mmo-engine/client"
  ],
  "bakes": [
    "world",
    "dungeon",
    "loot"
  ],
  "tests": [
    "@mmo-engine/scene"
  ],
  "valgrind": {
    "memcheck": [],
    "perf": false,
    "required": false
  },
  "modules": [
    "core",
    "characters"
  ],
  "edge": true,
  "env": {
    "MMO_PORT": "7790",
    "MMO_WORLD_SEED": "1234",
    "MMO_ALLOW_REGISTER": "0",
    "MMO_BOTS": "4",
    "EDGE_HTTP_PORT": "3010",
    "EDGE_WS_PORT": "3011",
    "CORE_CHANNEL_PORT": "4010"
  }
}
