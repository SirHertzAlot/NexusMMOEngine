        "subdivisions": 1,
        "controlPoints": "[{\"x\":0,\"y\":0,\"z\":0},{\"x\":0.05,\"y\":1.4,\"z\":0.02},{\"x\":0,\"y\":2.8,\"z\":0}]"
      }
    },
