        "stations": "[{\"u\":0,\"rx\":1.35,\"rz\":1.35,\"twist\":0},{\"u\":0.12,\"rx\":1,\"rz\":1,\"twist\":0},{\"u\":1,\"rx\":0.55,\"rz\":0.55,\"twist\":0}]"
      }
    },
    {
      "id": "bark",
