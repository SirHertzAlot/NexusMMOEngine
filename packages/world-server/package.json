{
  "dependencies": {
    "argon2": "^0.45.1",
    "express": "^5.1.0",
    "surrealdb": "^2.0.8",
    "zod": "^4.6.5"
  },
  "description": "World server: region registry, migration arbitration, global system of record (SurrealDB). Slices A and B: core, registry, webrpc adapter, migration arbitration.",
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^25.0.0",
    "typescript": "^5.6.3"
  },
  "main": "dist/src/index.js",
  "name": "@mmo-engine/world-server",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db": "surreal start --user root --pass root --bind 127.0.0.1:8000 rocksdb:./data/surrealdb",
    "server": "npm run build && node dist/src/server.js",
    "sidecar": "npm run build && node dist/src/host-sidecar.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\""
  },
  "type": "module",
  "types": "dist/src/index.d.ts",
  "version": "0.1.0"
}
