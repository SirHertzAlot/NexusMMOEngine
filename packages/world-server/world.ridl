// world.ridl — region<->world contract (webrpc IDL, v1)
//
// This file is the source of truth for the region<->world API. The
// TypeScript server adapter (src/adapters/webrpc.ts) and the region-side
// client (engine-core/src/world/webrpc-transport.ts) are hand-authored
// to the webrpc JSON wire protocol and MUST match this schema:
//
//   POST /rpc/World/<Method>  Content-Type: application/json
//   -> {"argName": ...}       <- {"outName": ...} | {"code": N, "msg": "..."}
//
// Auth: RegisterRegion bootstraps with the pre-shared apiKey in the
// body. Every other method requires:
//   Authorization: Bearer <lease.token>
// The adapter rejects unauthenticated callers before validation.
//
// Regenerating with webrpc-gen must be a drop-in replacement:
//   webrpc-gen -schema=world.ridl -target=typescript -out=./gen/
//
// Slice A: RegisterRegion, Heartbeat, DeregisterRegion, ReportSnapshot.
// Slice B: ListRegions and the migration methods. The world checks that
// the caller is the right party: the source begins, the target commits,
// either aborts while begun, either reads the record.

webrpc = v1

name = world
version = v0.1.0

service World
  - RegisterRegion(input: RegisterRegionInput) => (lease: RegionLease)
  - Heartbeat(input: HeartbeatInput) => (ack: HeartbeatAck)
  - DeregisterRegion(regionId: string, opId: string) => ()
  - ReportSnapshot(input: SnapshotReportInput) => ()

  # Slice B: cross-region entity migration arbitration
  - ListRegions() => (regions: []RegionInfo)
  - BeginMigration(input: BeginMigrationInput) => (migrationId: string)
  - CommitMigration(migrationId: string, opId: string) => ()
  - AbortMigration(migrationId: string, opId: string, reason: string) => ()
  # The record with its entity state: the target's backstop if the source dies
  - GetMigration(migrationId: string) => (migration: Migration)

  # Slice D4: the region's committed dungeon runs, idempotent on instance
  - ReportDungeonResults(input: ReportDungeonResultsInput) => (ingested: []string)

  # Slice S2: cross-region presence (state: replace + query)
  - SetPresence(input: SetPresenceInput) => ()
  - QueryPresence(input: QueryPresenceInput) => (online: map<string,string>)

  # Persistence P1: the state plane. Every registration re-issues the
  # range's fencing epoch (RegionLease.epoch, monotonically increasing
  # per chunk range); the writes below carry the writer's epoch and
  # the world rejects a stale one with 409. State is keyed by rangeKey
  # ("<x0>:<x1>:<z0>:<z1>", derived from the chunk range), never by
  # regionId alone. Reads are unfenced: boot recall precedes a grant.
  # Snapshot/character/lock outputs are null on the wire when absent.
  - PutShardSnapshot(input: PutShardSnapshotInput) => (snapshot: ShardSnapshot)
  - GetShardSnapshot(input: GetShardSnapshotInput) => (snapshot: ShardSnapshot)
  - AppendLedgerEvents(input: AppendLedgerEventsInput) => (ackedSeq: uint64)
  - GetLedgerEvents(input: GetLedgerEventsInput) => (events: []StoredLedgerEvent)
  - GetLedgerHead(input: GetLedgerHeadInput) => (ackedSeq: uint64)
  # Slice P4 contract, defined in P1: versioned character records and
  # session locks. Character writes are fenced by the lock epoch.
  - PutCharacterState(input: PutCharacterStateInput) => (character: CharacterState)
  # Batched save sweep: same per-record ceremony as PutCharacterState,
  # reported per record — a fenced record fails its own outcome only.
  - PutCharacterStates(input: PutCharacterStatesInput) => (outcomes: []PutCharacterStateOutcome)
  - GetCharacterState(input: GetCharacterStateInput) => (character: CharacterState)
  - AcquireCharacterLock(input: AcquireCharacterLockInput) => (lock: CharacterSessionLock)
  - ReleaseCharacterLock(input: ReleaseCharacterLockInput) => ()
  - GetCharacterLock(input: GetCharacterLockInput) => (lock: CharacterSessionLock)

  # Persistence P5: resource-aware chunk assignment. Host sidecars
  # report host capacity (bootstrap apiKey auth, like RegisterRegion —
  # the sidecar holds no lease token; state, not an event: no opId).
  # RegisterRegion gains an assignment mode: omit chunkRange and send
  # hostId instead, and the lease's chunkRange is the range the world
  # assigned, sized by the host's fresh report. Explicit registrations
  # (chunkRange present) are unchanged.
  - ReportHostResources(input: ReportHostResourcesInput) => (report: HostResourceReport)

  # Atomic operations (slice A1): the six value-moving exchanges as
  # world-tier DB functions. One operation = one WorldStore call = one
  # DB transaction: the state change and the item-ledger append commit
  # or fail together. Every op is idempotent on opId (a replay returns
  # the stored outcome and never re-applies) and fenced per
  # participating character by its session-lock epoch + the expected
  # record version. The outcome is a value, not an error: a business
  # rejection is { ok: false, rejection: <code> } with code one of
  # INSUFFICIENT_FUNDS | ITEM_NOT_PRESENT | VERSION_CONFLICT |
  # LOCK_CONFLICT | EPOCH_STALE, and nothing partially applied.
  # System counterparties (vendor, auction house, loot source) are
  # world-tier identities, so the transaction shape never changes.
  - TradeCommit(input: TradeCommitInput) => (result: AtomicOpResult)
  - VendorTransact(input: VendorTransactInput) => (result: AtomicOpResult)
  - AuctionSettle(input: AuctionSettleInput) => (result: AtomicOpResult)
  - CraftExecute(input: CraftExecuteInput) => (result: AtomicOpResult)
  - LootGrant(input: LootGrantInput) => (result: AtomicOpResult)
  - InventoryMutate(input: InventoryMutateInput) => (result: AtomicOpResult)

struct ChunkRange
  - x0: int32
  - x1: int32
  - z0: int32
  - z1: int32

struct RegisterRegionInput
  - regionId: string
  # The region's chunk range (explicit mode). In assignment mode (P5)
  # this field is OMITTED on the wire and hostId is sent instead; the
  # hand-authored adapter treats it as optional for exactly that case.
  - chunkRange: ChunkRange
  # Assignment mode (P5): the host this region runs on, whose fresh
  # resource report sizes the assigned range. Ignored when chunkRange
  # is present.
  - hostId: string
  # Where the region's game gateway listens (for future region->region links)
  - endpoint: string
  - capacity: uint32
  # Pre-shared key; compared (constant-time) against the world's argon2 hash
  - apiKey: string
  # Client-generated UUID for idempotent retries
  - opId: string

struct RegionLease
  - regionId: string
  # The granted chunk range (P5): the explicit range, or the range
  # the world assigned in assignment mode
  - chunkRange: ChunkRange
  - heartbeatIntervalMs: uint64
  - registryVersion: uint64
  # Opaque bearer token for subsequent calls (rotated on re-register)
  - token: string
  # Fencing epoch for this grant of the region's chunk range (P1);
  # state-plane writes must carry it, and a re-grant fences older ones
  - epoch: uint64

struct ReportHostResourcesInput
  - hostId: string
  - cpuCores: uint32
  - ramTotalBytes: uint64
  - ramFreeBytes: uint64
  # Co-located shard load when the sidecar can measure it; omitted otherwise
  - shardLoad: float64
  # Pre-shared bootstrap key, as in RegisterRegionInput
  - apiKey: string

struct HostResourceReport
  - hostId: string
  - cpuCores: uint32
  - ramTotalBytes: uint64
  - ramFreeBytes: uint64
  - shardLoad: float64
  # Server-stamped at ingestion (epoch ms); reports are TTL'd and
  # reaped like heartbeats
  - reportedAt: uint64

struct HeartbeatInput
  - regionId: string
  - load: float
  - tickJitterMs: float
  - entityCount: uint64

struct HeartbeatAck
  - ok: bool
  - registryVersion: uint64
  # Slice B: outcomes for this region's pending migrations
  - migrations: []MigrationOutcome

# Every migration naming the region that is begun or resolved recently;
# repeats are expected and must be handled idempotently.
struct MigrationOutcome
  - migrationId: string
  - entityId: string
  - fromRegion: string
  - toRegion: string
  # begun | committed | aborted | expired
  - state: string

struct RegionInfo
  - regionId: string
  - chunkRange: ChunkRange
  - endpoint: string
  - live: bool

struct BeginMigrationInput
  - opId: string
  - entityId: string
  - fromRegion: string
  - toRegion: string
  # Serialized ECS state (JSON object, at most 64 KiB)
  - entityState: map<string,any>

struct Migration
  - migrationId: string
  - entityId: string
  - fromRegion: string
  - toRegion: string
  - state: string
  - entityState: map<string,any>
  - reason: string
  - createdAt: uint64
  - updatedAt: uint64

struct SnapshotReportInput
  - regionId: string
  - tick: uint64
  - entityCount: uint64
  - digest: string

struct SetPresenceInput
  - regionId: string
  - names: []string

struct QueryPresenceInput
  - regionId: string
  - names: []string

struct ReportDungeonResultsInput
  - regionId: string
  - results: []DungeonRunResult

struct DungeonRunResult
  - instance: string
  - dungeon: string
  - entrance: string
  # cleared | timeout | abandoned
  - outcome: string
  - startedAt: uint64
  - endedAt: uint64
  - members: []uint64
  - kills: []DungeonKill
  - deaths: []DungeonDeath
  - loot: []DungeonLoot

struct DungeonKill
  - characterId: uint64
  - kind: string
  - count: uint64

struct DungeonDeath
  - characterId: uint64
  - count: uint64

struct DungeonLoot
  - characterId: uint64
  - def: uint64

struct PutShardSnapshotInput
  - regionId: string
  # "<x0>:<x1>:<z0>:<z1>" of the caller's registered chunk range
  - rangeKey: string
  - tick: uint64
  # The writer's fencing epoch (from its lease)
  - epoch: uint64
  - digest: string
  # Opaque snapshot payload (serialized world state); the world's
  # business is storing it verbatim for recall, never interpreting it
  - payload: map<string,any>
  - opId: string

struct ShardSnapshot
  - rangeKey: string
  # Region that wrote it (provenance; the key is the range)
  - regionId: string
  - tick: uint64
  - epoch: uint64
  - digest: string
  - payload: map<string,any>
  - storedAt: uint64

struct GetShardSnapshotInput
  - regionId: string
  - rangeKey: string

struct LedgerEvent
  # Source ledger sequence for the range (from 1, contiguous at the head)
  - seq: uint64
  - tick: uint64
  # Opaque ledger event payload, stored verbatim for replay
  - payload: map<string,any>

struct StoredLedgerEvent
  - rangeKey: string
  - seq: uint64
  - tick: uint64
  - payload: map<string,any>

struct AppendLedgerEventsInput
  - regionId: string
  - rangeKey: string
  - epoch: uint64
  - opId: string
  - events: []LedgerEvent

struct GetLedgerEventsInput
  - regionId: string
  - rangeKey: string
  # Return stored events with seq > afterSeq, in seq order
  - afterSeq: uint64

struct GetLedgerHeadInput
  - regionId: string
  - rangeKey: string

struct PutCharacterStateInput
  - regionId: string
  - characterId: uint64
  # The caller's session-lock epoch
  - epoch: uint64
  # Opaque serialized character state, stored verbatim
  - state: map<string,any>
  - opId: string

struct PutCharacterStatesInput
  - regionId: string
  # 1..32 entries (MAX_CHARACTER_STATE_BATCH in schema.ts)
  - inputs: []PutCharacterStateItem

struct PutCharacterStateItem
  - characterId: uint64
  # The caller's session-lock epoch
  - epoch: uint64
  # Opaque serialized character state, stored verbatim
  - state: map<string,any>
  - opId: string

struct PutCharacterStateOutcome
  - characterId: uint64
  - ok: bool
  # The stored record when ok; null on the wire when not
  - character: CharacterState
  # The single put's error code/message when not ok; 0/empty when ok
  - code: uint32
  - message: string

struct CharacterState
  - characterId: uint64
  - state: map<string,any>
  # Assigned by the world: 1 for the first put, +1 per accepted put
  - version: uint64
  - epoch: uint64
  - regionId: string
  - updatedAt: uint64

struct GetCharacterStateInput
  - regionId: string
  - characterId: uint64

struct AcquireCharacterLockInput
  - regionId: string
  - characterId: uint64
  # Lock lifetime in ms; the lock is stealable once this elapses
  - ttlMs: uint64
  - opId: string

struct CharacterSessionLock
  - characterId: uint64
  - regionId: string
  - epoch: uint64
  - expiresAt: uint64

struct ReleaseCharacterLockInput
  - regionId: string
  - characterId: uint64
  # Must match the held lock's epoch
  - epoch: uint64
  - opId: string

struct GetCharacterLockInput
  - regionId: string
  - characterId: uint64

# --- Atomic operations (slice A1) -------------------------------------
# A character record's opaque state carries gold + inventory for these
# operations (see CharacterState.state): gold is an integer balance and
# inventory a list of InventoryItem stacks. All other state keys are
# preserved verbatim by every operation.

struct ParticipantFence
  - characterId: uint64
  # The character's current session-lock epoch, as held by the caller
  - epoch: uint64
  # The record version the caller's decision was based on
  - expectedVersion: uint64

struct InventoryItem
  - instanceId: string
  - def: uint64
  - slot: uint64
  - count: uint64

struct AtomicLedgerEntry
  - seq: uint64
  - opId: string
  # tradeCommit | vendorTransact | auctionSettle | craftExecute |
  # lootGrant | inventoryMutate
  - op: string
  # item | gold
  - kind: string
  # Item movements only
  - instanceId: string
  - def: uint64
  # Owner identities: char:<characterId> or a system identity
  # (vendor:<id>, a loot sourceId, system:craft)
  - from: string
  - to: string
  # Gold movements only
  - amount: uint64
  # Item movements only: the stack size moved
  - count: uint64
  # inventoryMutate only
  - fromSlot: uint64
  - toSlot: uint64
  - at: uint64

struct AtomicOpResult
  - ok: bool
  - opId: string
  - op: string
  # Success only: the participating records after the commit
  - characters: []CharacterState
  # Success only: the ledger entries this operation appended
  - ledger: []AtomicLedgerEntry
  # Rejection only: INSUFFICIENT_FUNDS | ITEM_NOT_PRESENT |
  # VERSION_CONFLICT | LOCK_CONFLICT | EPOCH_STALE
  - rejection: string
  - message: string

struct TradeCommitInput
  - regionId: string
  - opId: string
  - a: ParticipantFence
  - b: ParticipantFence
  - aGivesGold: uint64
  - bGivesGold: uint64
  - aGivesItems: []string
  - bGivesItems: []string

struct VendorTransactInput
  - regionId: string
  - opId: string
  - participant: ParticipantFence
  - vendorId: string
  # buy | sell
  - direction: string
  - def: uint64
  - price: uint64
  - instanceId: string
  # Buy only; omitted = lowest free slot
  - slot: uint64

struct AuctionSettleInput
  - regionId: string
  - opId: string
  - buyer: ParticipantFence
  - seller: ParticipantFence
  - instanceId: string
  - price: uint64

struct CraftConsume
  - instanceId: string
  - count: uint64

struct CraftOutput
  - instanceId: string
  - def: uint64
  # Omitted = lowest free slot
  - slot: uint64
  # Omitted = 1
  - count: uint64

struct CraftExecuteInput
  - regionId: string
  - opId: string
  - participant: ParticipantFence
  - consumes: []CraftConsume
  - goldFee: uint64
  - outputs: []CraftOutput

struct LootGrantInput
  - regionId: string
  - opId: string
  - participant: ParticipantFence
  # The granting system identity, recorded as the ledger source
  - sourceId: string
  - instanceId: string
  - def: uint64
  # Omitted = lowest free slot
  - slot: uint64
  # Omitted = 1
  - count: uint64

struct InventoryMutation
  # move | swap | merge
  - kind: string
  # move: the item; merge: the stack folded away
  - instanceId: string
  # move only
  - toSlot: uint64
  # swap only
  - aInstanceId: string
  - bInstanceId: string
  # merge only: fromInstanceId folds into intoInstanceId
  - fromInstanceId: string
  - intoInstanceId: string

struct InventoryMutateInput
  - regionId: string
  - opId: string
  - participant: ParticipantFence
  - mutations: []InventoryMutation
