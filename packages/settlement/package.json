{
  "name": "@mmo-engine/settlement",
  "version": "0.1.0",
  "private": true,
  "description": "Procedural settlements, baked offline: demographics and economy drive districts, parcels and WFC-placed structures; deterministic per seed, validated by gates, emitted as a canonical manifest.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "npm run build --workspace=@mmo-engine/wfc && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "settlement:bake": "npm run build && node dist/src/cli.js"
  },
  "dependencies": {
    "zod": "^4.6.5",
    "@mmo-engine/wfc": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.6.3"
  },
  "bin": {
    "mmo-settlement-bake": "dist/src/cli.js"
  }
}
