{
  "name": "@mmo-engine/compose",
  "version": "0.1.0",
  "private": true,
  "description": "Ranks and entity composition: the rank ladder (names, loot shares, budgets, signals), the component catalog, and WFC over an entity's component tree, giving an ECS bundle with a client prefab. Creatures and items alike.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "npm run build --workspace=@mmo-engine/wfc && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "loot:bake": "npm run build && node dist/src/cli.js"
  },
  "dependencies": {
    "zod": "^4.6.5",
    "@mmo-engine/wfc": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.6.3"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./browser": {
      "types": "./dist/src/browser.d.ts",
      "default": "./dist/src/browser.js"
    }
  },
  "bin": {
    "mmo-loot-bake": "dist/src/cli.js"
  }
}
