{
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@mmo-engine/protocol": "^0.1.0",
    "@mmo-engine/schema": "0.1.0",
    "@three.ez/instanced-mesh": "^0.3.16",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "description": "Art asset pipeline contract: manifest schema + validation, pack directory scanning, and a manifest-backed THREE.js AssetProvider with placeholder fallback",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.186.0",
    "typescript": "^5.6.3"
  },
  "main": "dist/src/index.js",
  "name": "@mmo-engine/art",
  "private": true,
  "scripts": {
    "build": "npm run build --workspace=@mmo-engine/schema && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "convert:packs": "node dist/src/convert/convert-packs.js",
    "import:glb": "node dist/src/convert/import-glb-packs.js",
    "convert:modular": "node dist/src/convert/convert-modular.js",
    "convert:animations": "node dist/src/convert/convert-animations.js"
  },
  "type": "module",
  "types": "dist/src/index.d.ts",
  "version": "0.1.0",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./browser": {
      "types": "./dist/src/browser.d.ts",
      "default": "./dist/src/browser.js"
    },
    "./character": {
      "types": "./dist/src/character/index.d.ts",
      "default": "./dist/src/character/index.js"
    }
  }
}
