# dependencies
node_modules/

# FlatBuffers generated code — rebuilt by `npm run codegen`, never hand-edited
packages/schema/generated/

# compiled output
dist/
*.tsbuildinfo

# sim benchmark artifacts (regenerable via `npm run sim`)
sim-artifacts/
valgrind-out/

# native addon build output
build/
!packages/build/
# build profiles are content (EA19), not build output
!content/build/
*.node

# misc
.DS_Store
.env

# SQLite world databases (default ./data/world.db) — never commit
data/
# ...but vendored source trees may have a data/ directory of their own
!packages/addons/picg/third_party/pcg-core/src/data/

# prebuilt native addon tarballs (regenerable via `npm run prebuild`)
prebuilds/

# vite production bundle (apps/client)
dist-app/

# Licensed art (served by the editor from <repo>/assets) — CONFIDENTIAL,
# must never be committed or pushed. Anchored to the repo root so it
# can't match vendored dirs like JoltPhysics/Assets on case-insensitive
# filesystems.
/assets/

# Repo archives and handoff patches can bundle the art above
/patches/
*.zip

# preview:world output (regenerable)
world-preview.png

# Terrain surface textures (CC0, fetched by `npm run surfaces:fetch`, never committed)
paperclip_snippets/
paperclip_update.ps1
apps/client/public/surfaces/

# Codebase snapshot dumps (copies of the repo itself; regenerate, never commit)
/docs/kb/

#Valgrind reports
/perf/

# settlement scenes name licensed art models: bake locally, never commit
/content/scenes/settlement-*.scene.json

# per-model scale fit: names licensed models (settlement:scale-fit), never commit
content/scale.local.json

# wildlife ecology plan: lists licensed models by id (wildlife:plan), never commit
packages/engine-core/content/ecology/*.local.ecology.json
packages/engine-core/content/wildlife/*.local.json
# Enemy art (EM1) names licensed catalog models: bake locally, never commit
packages/engine-core/content/enemies/*.local.json

# bake:all outputs under the content folder: they name licensed models or are machine-local
/content/bake-env.local.txt
/content/ecology/*.local.ecology.json
/content/wildlife/*.local.json

# Dungeon prop art overlay: names licensed catalog models (npm run dungeon:art); local only
content/dungeons/props.local.json

# Graphify indexing caches and reports
graphify-out/
packages/graphify-out/

# Engine-core runtime data written by a running server (world, saves, logs,
# bake output). Generated locally; never commit. Tracked files are unaffected.
packages/engine-core/*.db-shm
packages/engine-core/*.db-wal
packages/engine-core/characters.db
packages/engine-core/gathering.db
packages/engine-core/guilds.db
packages/engine-core/instances.db
packages/engine-core/parties.db
packages/engine-core/places.db
packages/engine-core/quests.db
packages/engine-core/social.db
packages/engine-core/world.db
packages/engine-core/users.csv
packages/engine-core/dungeons/
packages/engine-core/logs/
packages/engine-core/loot/
packages/engine-core/navmesh/
packages/engine-core/surreal/
