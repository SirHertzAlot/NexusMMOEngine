# dependencies
node_modules/

# FlatBuffers generated code — rebuilt by `npm run codegen`, never hand-edited
packages/schema/generated/

# compiled output
dist/
*.tsbuildinfo

# sim benchmark artifacts (regenerable via `npm run sim`)
sim-artifacts/
valgrind-out/

# native addon build output
build/
!packages/build/
# build profiles are content (EA19), not build output
!content/build/
*.node

# misc
.DS_Store
.env

# SQLite world databases (default ./data/world.db) — never commit
data/
# ...but vendored source trees may have a data/ directory of their own
!packages/addons/picg/third_party/pcg-core/src/data/

# prebuilt native addon tarballs (regenerable via `npm run prebuild`)
prebuilds/

# vite production bundle (apps/client)
dist-app/

# Licensed art (served by the editor from <repo>/assets) — CONFIDENTIAL,
# must never be committed or pushed. Anchored to the repo root so it
# can't match vendored dirs like JoltPhysics/Assets on case-insensitive
# filesystems.
/assets/

# Repo archives and handoff patches can bundle the art above
/patches/
*.zip

# preview:world output (regenerable)
world-preview.png

# Terrain surface textures (CC0, fetched by `npm run surfaces:fetch`, never committed)
apps/client/public/surfaces/

# Codebase snapshot dumps (copies of the repo itself; regenerate, never commit)
/docs/kb/

# settlement scenes name licensed art models: bake locally, never commit
/content/scenes/settlement-*.scene.json

# per-model scale fit: names licensed models (settlement:scale-fit), never commit
content/scale.local.json
